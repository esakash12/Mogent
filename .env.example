# ==============================================================================
# MOGENT - ENTERPRISE AI SAAS CONFIGURATION
# ==============================================================================

NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase / Neon with PgBouncer Transaction Pooler)
# ------------------------------------------------------------------------------
# IMPORTANT: Use Supabase Transaction Pooler (Port 6543) with ?pgbouncer=true&connection_limit=10
# This prevents "Connection Pool Exhausted" errors during high-volume webhook bursts!
DATABASE_URL="postgresql://postgres.your_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# Direct database URL for Prisma migrations strictly (Port 5432)
DIRECT_URL="postgresql://postgres:your_password@db.your_supabase_project.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. MESSAGE QUEUE & REDIS PERSISTENCE (BullMQ & Key-Rotator Cooldown)
# ------------------------------------------------------------------------------
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD="mogent_redis_secret"
REDIS_DB=0

# ------------------------------------------------------------------------------
# 3. AI GATEWAY (Standalone Dedicated Proxy with 8x Rotating Keys)
# ------------------------------------------------------------------------------
# URL to your standalone AI Proxy Gateway server (Internal docker host: http://ai-proxy:5000)
AI_PROXY_URL="http://localhost:5000"
# Master API Key (shohag) used by Vultr Backend to authenticate with AI Proxy
MOGENT_AI_MASTER_KEY="shohag_ai_master_secret_2026"
DEFAULT_GEMINI_MODEL="gemini-2.0-flash"

# (On AI-Proxy Server): Comma-separated 8 free Gemini API keys
GEMINI_API_KEYS="AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3...,AIzaSyKey4...,AIzaSyKey5...,AIzaSyKey6...,AIzaSyKey7...,AIzaSyKey8..."

# ------------------------------------------------------------------------------
# 4. FACEBOOK GRAPH API & WEBHOOK
# ------------------------------------------------------------------------------
FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_APP_SECRET="your_facebook_app_secret"
FACEBOOK_WEBHOOK_VERIFY_TOKEN="your_random_secure_verify_token_32chars"
FACEBOOK_GRAPH_API_VERSION="v20.0"

# ------------------------------------------------------------------------------
# 5. SECURITY & ENCRYPTION (AES-256)
# ------------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY="replace_with_a_super_secret_32_byte_encryption_key!"

# ------------------------------------------------------------------------------
# 6. TELEGRAM ALERT BOT
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# ------------------------------------------------------------------------------
# 7. NEXT.JS / AUTHENTICATION
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="your_nextauth_jwt_secret_key_here"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
