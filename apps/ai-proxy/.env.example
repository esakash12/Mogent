# Option 1: Comma-separated list of 8 Gemini API Keys
GEMINI_API_KEYS="AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3...,AIzaSyKey4...,AIzaSyKey5...,AIzaSyKey6...,AIzaSyKey7...,AIzaSyKey8..."

