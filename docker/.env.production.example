# ==============================================================================
# MOGENT PRODUCTION CONFIGURATION (Vultr VPS / Docker Host)
# ==============================================================================

# Your root domain (e.g. mogent.io or mybusiness.com)
DOMAIN=yourdomain.com
PUBLIC_API_URL=https://api.yourdomain.com

# Database (Native Docker Postgres on Vultr)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_super_strong_postgres_password_2026
POSTGRES_DB=mogent_prod
DATABASE_URL=postgresql://postgres:generate_a_super_strong_postgres_password_2026@postgres:5432/mogent_prod
DIRECT_URL=postgresql://postgres:generate_a_super_strong_postgres_password_2026@postgres:5432/mogent_prod

# Redis (Internal In-Memory Cache)
REDIS_PASSWORD=generate_a_secure_redis_password_2026

# Standalone Gemini AI Rotator Proxy
MOGENT_AI_MASTER_KEY=shohag_ai_master_secret_2026
DEFAULT_GEMINI_MODEL=gemini-2.0-flash
# Comma-separated free Gemini API keys
GEMINI_API_KEYS=AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3...,AIzaSyKey4...

# Facebook Graph API & Webhook
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your_random_secure_32_char_verify_token

# AES-256 Token Encryption Key (32-character secret string)
TOKEN_ENCRYPTION_KEY=super_secret_32_char_encryption_key_!

# Telegram Alert Bot (Optional)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
