FROM node:22-alpine AS base

RUN apk add --no-cache libc6-compat
WORKDIR /app

# Stage 1: Install dependencies
FROM base AS dependencies
COPY package.json turbo.json ./
COPY apps/ai-proxy/package.json ./apps/ai-proxy/
COPY packages/shared/package.json ./packages/shared/

RUN npm install

# Stage 2: Build
FROM base AS builder
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json turbo.json ./
COPY packages/shared ./packages/shared
COPY apps/ai-proxy ./apps/ai-proxy

RUN cd packages/shared && npm run build
RUN cd apps/ai-proxy && npm run build

# Stage 3: Runner
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV AI_PROXY_PORT=5000

COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/apps/ai-proxy ./apps/ai-proxy

EXPOSE 5000

CMD ["node", "apps/ai-proxy/dist/index.js"]
